\@ifundefined {etoctocstyle}{\let \etoc@startlocaltoc \@gobble \let \etoc@settocdepth \@gobble \let \etoc@depthtag \@gobble \let \etoc@setlocaltop \@gobble }{}
\contentsline {chapter}{\numberline {1}<Chapter Title 1>}{1}{chapter.1}%
\etoc@startlocaltoc {2}
\contentsline {section}{\numberline {1.1}<Section Title 1>}{1}{section.1.1}%
\etoc@startlocaltoc {3}
\contentsline {subsection}{\numberline {1.1.1}<Theorem Title 1>}{1}{section*.4}%
\contentsline {subsection}{\numberline {1.1.2}<Definition Title 1>}{1}{section*.5}%
\contentsline {subsection}{\numberline {1.1.3}<Figure Title 1>}{1}{figure.caption.6}%
\contentsline {section}{\numberline {1.2}<Section Title 2>}{1}{section.1.2}%
\etoc@startlocaltoc {4}
\contentsline {chapter}{Proofs}{3}{section*.12}%
\etoc@startlocaltoc {5}
\contentsline {chapter}{References}{4}{section*.15}%
