<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" page-range-format="expanded">
  <info>
    <title>ProjTool SIADS References with Chronological Type Labels</title>
    <id>https://projtool.local/styles/siam-references</id>
    <updated>2026-10-18T00:00:00+00:00</updated>
  </info>
  <macro name="authors">
    <names variable="author">
      <name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="contextual" font-variant="small-caps"/>
      <substitute>
        <names variable="editor">
          <name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="contextual" font-variant="small-caps"/>
          <label form="short" prefix=", "/>
        </names>
      </substitute>
    </names>
  </macro>
  <macro name="editors">
    <names variable="editor">
      <name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="contextual"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <macro name="type">
    <choose>
      <if type="article-journal">
        <text value="Journal Paper"/>
      </if>
      <else-if type="paper-conference chapter" match="any">
        <text value="Conference Paper"/>
      </else-if>
      <else-if type="book">
        <text value="Book"/>
      </else-if>
      <else-if type="thesis">
        <text value="Thesis"/>
      </else-if>
      <else>
        <text value="Preprint"/>
      </else>
    </choose>
  </macro>
  <macro name="title">
    <text variable="title" font-style="italic"/>
  </macro>
  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <macro name="links">
    <group delimiter=", ">
      <text variable="DOI" prefix="https://doi.org/"/>
      <group delimiter=": ">
        <text variable="archive"/>
        <text variable="archive_location"/>
      </group>
      <group delimiter=" ">
        <text variable="URL"/>
        <date variable="accessed" prefix="(accessed " suffix=")">
          <date-part name="day" suffix=" "/>
          <date-part name="month" form="short" suffix=" "/>
          <date-part name="year"/>
        </date>
      </group>
    </group>
  </macro>
  <macro name="edition">
    <group delimiter=" ">
      <number variable="edition" form="ordinal"/>
      <text term="edition" form="short"/>
    </group>
  </macro>
  <macro name="series">
    <choose>
      <if variable="collection-title">
        <group delimiter=" ">
          <text variable="collection-title"/>
          <text variable="volume"/>
        </group>
      </if>
      <else>
        <text variable="volume" prefix="vol. "/>
      </else>
    </choose>
  </macro>
  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="journal">
    <group delimiter=", ">
      <text variable="container-title" form="short"/>
      <choose>
        <if variable="status">
          <text variable="status"/>
        </if>
        <else>
          <group>
            <text variable="volume"/>
            <text macro="year" prefix=" (" suffix=")"/>
          </group>
          <group delimiter=" ">
            <text variable="number"/>
            <text variable="number-of-pages" prefix="(" suffix=")"/>
          </group>
          <text macro="pages"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="conference">
    <group delimiter=", ">
      <text variable="container-title" prefix="in "/>
      <text macro="editors"/>
      <text macro="series"/>
      <choose>
        <if variable="publisher-place">
          <text variable="publisher-place"/>
          <text macro="year"/>
          <text variable="publisher"/>
        </if>
        <else>
          <text variable="publisher"/>
          <text macro="year"/>
        </else>
      </choose>
      <text macro="pages"/>
    </group>
  </macro>
  <macro name="chapter">
    <group delimiter=", ">
      <text variable="container-title" prefix="in "/>
      <text macro="series"/>
      <text macro="editors"/>
      <text variable="publisher"/>
      <text variable="publisher-place"/>
      <text macro="year"/>
      <text macro="pages"/>
    </group>
  </macro>
  <macro name="reference">
    <text macro="type" prefix="(" suffix=") "/>
    <group delimiter=", ">
      <text macro="authors"/>
      <text macro="title"/>
      <choose>
        <if type="article-journal">
          <text macro="journal"/>
          <text macro="links"/>
        </if>
        <else-if type="paper-conference">
          <choose>
            <if variable="event-title"><text macro="journal"/></if>
            <else><text macro="conference"/></else>
          </choose>
          <text macro="links"/>
        </else-if>
        <else-if type="chapter">
          <text macro="chapter"/>
          <text macro="links"/>
        </else-if>
        <else-if type="book">
          <text macro="edition"/>
          <text macro="series"/>
          <choose><if variable="author"><text macro="editors"/></if></choose>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text macro="year"/>
          <text macro="links"/>
        </else-if>
        <else-if type="thesis">
          <text variable="genre"/>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text macro="year"/>
          <text macro="links"/>
        </else-if>
        <else>
          <group delimiter=" ">
            <text variable="genre"/>
            <text variable="number"/>
          </group>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text macro="links"/>
          <text macro="year"/>
        </else>
      </choose>
    </group>
  </macro>
  <citation>
    <sort>
      <key variable="issued"/>
      <key variable="author"/>
      <key variable="title"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <sort>
      <key variable="issued"/>
      <key variable="author"/>
      <key variable="title"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="reference" suffix="."/>
    </layout>
  </bibliography>
</style>
