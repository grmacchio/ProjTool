<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text">
  <info>
    <title>ProjTool SIAM References</title>
    <id>https://projtool.local/styles/siam-references</id>
    <updated>2026-09-02T00:00:00+00:00</updated>
  </info>
  <macro name="authors">
    <names variable="author">
      <name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="always" font-variant="small-caps"/>
    </names>
  </macro>
  <macro name="type">
    <choose>
      <if type="article-journal" match="any">
        <text value="Paper"/>
      </if>
      <else-if type="book" match="any">
        <text value="Book"/>
      </else-if>
      <else-if type="thesis" match="any">
        <text value="Thesis"/>
      </else-if>
      <else>
        <text value="Preprint"/>
      </else>
    </choose>
  </macro>
  <macro name="title">
    <text variable="title" text-case="sentence" font-style="italic"/>
  </macro>
  <macro name="date">
    <date variable="issued">
      <date-part name="month" form="short" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="links">
    <group delimiter=", ">
      <text variable="DOI" prefix="https://doi.org/"/>
      <text variable="URL"/>
    </group>
  </macro>
  <macro name="reference">
    <group suffix=", ">
      <text macro="type" prefix="(" suffix=") "/>
      <text macro="authors"/>
    </group>
    <choose>
      <if type="article-journal" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text variable="container-title"/>
          <group>
            <text variable="volume"/>
            <date variable="issued" prefix=" (" suffix=")">
              <date-part name="year"/>
            </date>
          </group>
          <text variable="page" prefix="pp. "/>
          <text macro="links"/>
        </group>
      </if>
      <else-if type="book" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <text variable="edition" suffix=" ed."/>
          <date variable="issued"><date-part name="year"/></date>
          <text macro="links"/>
        </group>
      </else-if>
      <else-if type="thesis" match="any">
        <group delimiter=", ">
          <text macro="title"/>
          <text value="PhD thesis"/>
          <text variable="publisher"/>
          <text variable="publisher-place"/>
          <date variable="issued"><date-part name="year"/></date>
          <text macro="links"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <text macro="title"/>
          <text variable="genre"/>
          <text macro="date"/>
          <text macro="links"/>
        </group>
      </else>
    </choose>
  </macro>
  <citation>
    <sort>
      <key variable="issued"/>
      <key variable="author"/>
      <key variable="title"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0" line-spacing="1">
    <sort>
      <key variable="issued"/>
      <key variable="author"/>
      <key variable="title"/>
    </sort>
    <layout>
      <text variable="citation-number" prefix="[" suffix="]"/>
      <text macro="reference" suffix="."/>
    </layout>
  </bibliography>
</style>
